<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_control"
            android:textColor="?attr/textColor"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/remote_devices"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="?attr/boxItemBackground"
            android:contentDescription="@string/remote_discovered_devices" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/remote_tv_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/remote_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_connect"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="@string/remote_connect" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remote_pair"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/companion_pair_now" />

        <TextView
            android:id="@+id/remote_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_not_connected"
            android:textColor="?attr/grayTextColor"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remote_launch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/remote_launch" />

        <GridLayout
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="3">

            <Space
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_up"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="@string/remote_up"
                android:textSize="28sp"
                app:cornerRadius="48dp" />

            <Space
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_left"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="@string/remote_left"
                android:textSize="28sp"
                app:cornerRadius="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_ok"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="@string/remote_ok"
                android:textSize="20sp"
                app:cornerRadius="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_right"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="@string/remote_right"
                android:textSize="28sp"
                app:cornerRadius="48dp" />

            <Space
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_down"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="@string/remote_down"
                android:textSize="28sp"
                app:cornerRadius="48dp" />

            <Space
                android:layout_width="96dp"
                android:layout_height="96dp" />
        </GridLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_back"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_play_pause"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_play_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_mute"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_mute" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_rewind"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_rewind" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_forward"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_forward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_browse"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_browse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_volume_down"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_volume_down" />

            <Space
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_volume_up"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/remote_volume_up" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/remote_text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:hint="@string/remote_type_on_tv"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/textColor"
                android:textColorHint="?attr/grayTextColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_send_text"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="@string/remote_send" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
