<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/primaryGrayBackground"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/now_playing_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:letterSpacing="0.12"
        android:text="@string/companion_now_playing_eyebrow"
        android:textAllCaps="true"
        android:textColor="?attr/grayTextColor"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/now_playing_poster"
            android:layout_width="96dp"
            android:layout_height="132dp"
            android:background="@color/grayShimmer"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/now_playing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="?attr/textColor"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="The Perfect Run" />

            <TextView
                android:id="@+id/now_playing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp"
                tools:text="Episode 1 · Playing on TV" />

            <TextView
                android:id="@+id/now_playing_stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/textColor"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="HDHub4u.Ag · 1080p"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/now_playing_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp"
                tools:text="12:34 / 45:00" />

            <SeekBar
                android:id="@+id/now_playing_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                tools:progress="300" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/now_playing_tracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/now_playing_source"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/companion_sources"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/now_playing_video_track"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_tracks"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/now_playing_audio_track"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_tracks"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/now_playing_disable_subtitles"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/companion_subtitles"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/now_playing_rewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/companion_seek_back"
            android:src="@drawable/baseline_skip_previous_24"
            app:tint="?attr/textColor" />

        <ImageButton
            android:id="@+id/now_playing_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remote_play_pause"
            android:src="@drawable/ic_baseline_play_arrow_24"
            app:tint="?attr/textColor" />

        <ImageButton
            android:id="@+id/now_playing_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/companion_seek_forward"
            android:src="@drawable/ic_baseline_fast_forward_24"
            app:tint="?attr/textColor" />

        <ImageButton
            android:id="@+id/now_playing_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/companion_stop_playback"
            android:src="@drawable/baseline_stop_24"
            app:tint="?attr/textColor" />
    </LinearLayout>
</LinearLayout>
